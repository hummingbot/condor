{
  "mcpServers": {
    "condor": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "mcp_servers.condor"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "condor-notifications": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "integrations/claude_channel/condor-channel.ts"
      ],
      "env": {}
    }
  }
}
